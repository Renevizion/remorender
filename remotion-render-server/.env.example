# Environment variables for local development and Remotion Studio

# Server Configuration
PORT=3001

# Supabase Configuration (optional for local testing)
# Leave empty to test without Supabase integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Upload endpoint URL (for webhook approach)
# This should point to your Supabase upload-video edge function
# Example: https://your-project.supabase.co/functions/v1/upload-video
UPLOAD_ENDPOINT_URL=

# Optional: Node Environment
NODE_ENV=production

# ============================================
# Remotion Studio Variables
# ============================================
# Use these when running `npm run dev` to load compositions with external resources

# Example: Load a video from Supabase Storage in the SupabaseVideo composition
# REMOTION_VIDEO_URL=https://your-project.supabase.co/storage/v1/object/public/rendered-videos/your-video.mp4

# Add your own custom environment variables for compositions
# These can be accessed in your Remotion components via process.env
# REMOTION_CUSTOM_TEXT=My Custom Text
# REMOTION_LOGO_URL=https://example.com/logo.png
