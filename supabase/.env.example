# Supabase Edge Functions Environment Variables

# Railway render server URL
# This is where the render-video edge function will send render jobs
RAILWAY_RENDER_URL=https://your-app.railway.app

# Supabase Configuration
# These are automatically available in Lovable Cloud edge functions
# Only needed if using Supabase CLI locally
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
